---
import BaseLayout from './BaseLayout.astro';
import { getCollection } from 'astro:content';
import { chapterBadge } from '../lib/chapter';

interface Props {
  title: string;
  description: string;
  activeId?: string;
  prev?: { href: string; title: string } | null;
  next?: { href: string; title: string } | null;
}

const { title, description, activeId, prev = null, next = null } = Astro.props;

const chapters = (await getCollection('docs')).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout title={title} description={description} wide>
  <div class="docs-shell container-wide">
    <aside class="docs-side">
      <nav aria-label="教程目录">
        <a class="side-home" href="/docs">教程总览</a>
        <ul>
          {
            chapters.map((ch) => (
              <li>
                <a
                  class:list={['side-link', { active: ch.id === activeId }]}
                  href={`/docs/${ch.id}`}
                >
                  <span class="side-no" aria-hidden="true">
                    {chapterBadge(ch.data.order)}
                  </span>
                  {ch.data.title}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </aside>

    <article class="docs-main prose">
      <slot />
      {
        (prev || next) && (
          <nav class="pager" aria-label="章节翻页">
            {prev ? (
              <a class="pager-item prev" href={prev.href}>
                <span class="pager-label">上一章</span>
                <span class="pager-title">{prev.title}</span>
              </a>
            ) : (
              <span />
            )}
            {next && (
              <a class="pager-item next" href={next.href}>
                <span class="pager-label">下一章</span>
                <span class="pager-title">{next.title}</span>
              </a>
            )}
          </nav>
        )
      }
    </article>
  </div>
</BaseLayout>

<style>
  .docs-shell {
    display: grid;
    grid-template-columns: 236px minmax(0, 1fr);
    gap: 56px;
    padding-top: 40px;
    padding-bottom: 88px;
  }

  .docs-side {
    position: sticky;
    top: 84px;
    align-self: start;
    max-height: calc(100vh - 108px);
    overflow-y: auto;
  }

  .side-home {
    display: block;
    font-size: 13px;
    font-weight: 600;
    color: var(--text-tertiary);
    text-decoration: none;
    letter-spacing: 0.02em;
    padding: 4px 10px;
    margin-bottom: 10px;
  }

  .side-home:hover {
    color: var(--accent-text);
  }

  .docs-side ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 2px;
    border-left: 1px solid var(--border);
  }

  .side-link {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 7px 10px 7px 14px;
    margin-left: -1px;
    border-left: 2px solid transparent;
    font-size: 14px;
    color: var(--text-secondary);
    text-decoration: none;
    border-radius: 0 8px 8px 0;
  }

  .side-link:hover {
    color: var(--text-primary);
    background: var(--bg-secondary);
  }

  .side-link.active {
    color: var(--accent-text);
    background: var(--accent-bg);
    border-left-color: var(--accent);
    font-weight: 500;
  }

  .side-no {
    flex-shrink: 0;
    min-width: 22px;
    height: 20px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--text-tertiary);
    border: 1px solid var(--border);
    border-radius: 5px;
    background: var(--bg-primary);
  }

  .side-link.active .side-no {
    color: var(--accent-text);
    border-color: var(--accent);
  }

  .docs-main {
    min-width: 0;
  }

  .pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 14px;
    margin-top: 56px;
    padding-top: 28px;
    border-top: 1px solid var(--border);
  }

  .pager-item {
    display: flex;
    flex-direction: column;
    gap: 3px;
    padding: 16px 20px;
    border: 1px solid var(--border);
    border-radius: var(--radius-card);
    text-decoration: none;
    transition: border-color 0.15s ease;
  }

  .pager-item:hover {
    border-color: var(--accent);
  }

  .pager-item.next {
    text-align: right;
  }

  .pager-label {
    font-size: 12px;
    color: var(--text-tertiary);
  }

  .pager-title {
    font-size: 14.5px;
    font-weight: 500;
    color: var(--text-primary);
  }

  @media (max-width: 900px) {
    .docs-shell {
      grid-template-columns: 1fr;
      gap: 32px;
    }

    .docs-side {
      position: static;
      max-height: none;
    }

    .docs-side ul {
      flex-direction: row;
      flex-wrap: wrap;
      gap: 6px;
      border-left: none;
    }

    .side-link {
      border: 1px solid var(--border);
      border-radius: 999px;
      padding: 5px 14px;
      margin-left: 0;
    }

    .side-link.active {
      border-color: var(--accent);
      margin-left: 0;
    }

    .pager {
      grid-template-columns: 1fr;
    }

    .pager-item.next {
      text-align: left;
    }
  }
</style>

<style is:global>
  /* ---------- 文档正文排版（prose） ---------- */
  .prose {
    font-size: 16px;
    line-height: 1.85;
    color: var(--text-primary);
    max-width: 760px;
  }

  .prose h1,
  .prose h2,
  .prose h3,
  .prose h4 {
    font-weight: 600;
    line-height: 1.4;
    scroll-margin-top: 84px;
  }

  .prose h2 {
    font-size: 24px;
    margin: 44px 0 16px;
    padding-top: 20px;
    border-top: 1px solid var(--border);
  }

  .prose > h2:first-child {
    margin-top: 0;
    padding-top: 0;
    border-top: none;
  }

  .prose h3 {
    font-size: 18px;
    margin: 30px 0 12px;
  }

  .prose h4 {
    font-size: 16px;
    margin: 22px 0 10px;
  }

  .prose p {
    margin: 0 0 14px;
  }

  .prose a {
    color: var(--accent-text);
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
  }

  .prose ul,
  .prose ol {
    margin: 0 0 16px;
    padding-left: 24px;
  }

  .prose li {
    margin-bottom: 6px;
  }

  .prose :not(pre) > code {
    background: var(--bg-secondary);
    border: 1px solid var(--border);
    border-radius: 5px;
    padding: 1px 7px;
    font-size: 0.86em;
    color: var(--text-primary);
    white-space: nowrap;
  }

  .prose pre {
    background: var(--ov-surface);
    border-radius: var(--radius-card);
    padding: 18px 20px;
    overflow-x: auto;
    margin: 0 0 18px;
  }

  .prose pre code {
    background: none;
    border: none;
    padding: 0;
    color: var(--ov-fg);
    font-size: 13.2px;
    line-height: 1.8;
    white-space: pre;
  }

  .prose blockquote {
    margin: 0 0 18px;
    padding: 14px 18px;
    background: var(--accent-bg);
    border-left: 3px solid var(--accent);
    border-radius: 0 10px 10px 0;
    color: var(--text-secondary);
    font-size: 15px;
  }

  .prose blockquote p:last-child {
    margin-bottom: 0;
  }

  .prose img {
    display: block;
    margin: 20px auto 24px;
    border: 1px solid var(--border);
    border-radius: 10px;
    box-shadow: 0 8px 28px rgba(28, 28, 30, 0.08);
  }

  .prose table {
    width: 100%;
    border-collapse: collapse;
    margin: 0 0 20px;
    font-size: 14.5px;
  }

  .prose th,
  .prose td {
    border: 1px solid var(--border);
    padding: 9px 14px;
    text-align: left;
    vertical-align: top;
  }

  .prose th {
    background: var(--bg-secondary);
    font-weight: 600;
    white-space: nowrap;
  }

  .prose tr:nth-child(even) td {
    background: var(--bg-secondary);
  }

  .prose hr {
    border: none;
    border-top: 1px solid var(--border);
    margin: 32px 0;
  }
</style>
